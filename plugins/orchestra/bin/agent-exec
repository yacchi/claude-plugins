#!/bin/sh
# agent-exec entry point on the Bash tool's PATH inside Claude Code (Claude
# Code adds a plugin's bin/ there). Resolves its own real directory, following
# symlinks, and hands off to the real launcher in ../tools/agent-exec.
# Outside Claude Code, `agent-exec install` writes a shim to a directory on
# your PATH instead.

SELF=$0
while [ -L "$SELF" ]; do
    LINK=$(readlink -- "$SELF") || exit 1
    case "$LINK" in
        /*) SELF=$LINK ;;
        *) SELF=$(dirname -- "$SELF")/$LINK ;;
    esac
done
DIR=$(CDPATH= cd -P -- "$(dirname -- "$SELF")" && pwd) || exit 1

exec "$DIR/../tools/agent-exec" "$@"
