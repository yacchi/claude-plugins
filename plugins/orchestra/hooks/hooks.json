{
  "description": "Injects the orchestra routing protocol (express vs orchestrated lane) at session start, re-injects it after /clear, resume, and compaction, and appends a short per-prompt reminder so the router survives long sessions",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/inject-router.sh"],
            "timeout": 10,
            "statusMessage": "Injecting orchestra router..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/remind-router.sh"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
