{
  "description": "Injects the orchestra routing protocol (express vs orchestrated lane) at session start, re-injects it after /clear, resume, and compaction, appends a short per-prompt reminder so the router survives long sessions, asks the main thread to re-classify into the orchestrated lane once a single turn has hand-edited enforcement.turn_edits files, blocks a subagent from running destructive VCS commands against the user's shared working tree (enforcement.worker_vcs, on by default), blocks a worker subagent that has an orchestra worktree of its own from writing into the user's main working tree (enforcement.worker_tree, on by default), denies `git stash` to workers in every worktree because the stash stack is shared, leases each linked worktree to one writing subagent at a time and releases the lease at SubagentStop (enforcement.worktree_lease, on by default), (opt-in, off by default) nudges a direct Claude Haiku subagent spawn toward `agent-exec dispatch` once per task when enforcement.light_class=block, and removes the finishing session's orchestra worktrees at SessionEnd, keeping any that still hold uncollected changes (enforcement.session_cleanup, on by default), with independent escape hatches so none of these can become a hard wall",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/inject-router.sh"
            ],
            "timeout": 10,
            "statusMessage": "Injecting orchestra router..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/remind-router.sh"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/guard-worker-vcs.sh"
            ],
            "timeout": 15,
            "statusMessage": "Checking worker VCS safety..."
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/guard-worker-tree.sh"
            ],
            "timeout": 15,
            "statusMessage": "Checking worker working-tree confinement..."
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/guard-worktree-lease.sh"
            ],
            "timeout": 15,
            "statusMessage": "Checking worktree lease..."
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/enforce-router.sh"
            ],
            "timeout": 15,
            "statusMessage": "Checking light-class enforcement policy..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/count-turn-edits.sh"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/guard-worktree-lease.sh",
              "--release"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/cleanup-worktrees.sh"
            ],
            "timeout": 30,
            "statusMessage": "Cleaning up orchestra worktrees..."
          }
        ]
      }
    ]
  }
}
