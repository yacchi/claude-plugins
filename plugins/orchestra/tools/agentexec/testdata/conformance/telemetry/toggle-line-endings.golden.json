{
  "scenario": "telemetry/toggle-line-endings",
  "steps": [
    {
      "argv": [
        "telemetry",
        "enable"
      ],
      "exit": 0,
      "stdout_shape": "text",
      "stdout": "telemetry enabled -> <HOME>/.claude/orchestra.yaml\n",
      "stderr": "",
      "files": {
        "~/.claude/orchestra.yaml": {
          "content": "tiers:\n  light: sonnet\ntelemetry:\n  enabled: true  # c\nother: 1\n",
          "shape": "text"
        }
      }
    },
    {
      "argv": [
        "telemetry",
        "enable",
        "--scope",
        "project"
      ],
      "exit": 0,
      "stdout_shape": "text",
      "stdout": "telemetry enabled -> <WORK>/.claude/orchestra.yaml\n",
      "stderr": "",
      "files": {
        ".claude/orchestra.yaml": {
          "content": "tiers: {light: sonnet}\ntelemetry:\n  enabled: true\n  dir: x\nother: 1\n",
          "shape": "text"
        }
      }
    },
    {
      "argv": [
        "telemetry",
        "enable",
        "--scope",
        "local"
      ],
      "exit": 0,
      "stdout_shape": "text",
      "stdout": "telemetry enabled -> <WORK>/.claude/orchestra.local.yaml\n",
      "stderr": "",
      "files": {
        ".claude/orchestra.local.yaml": {
          "content": "a: 1\u2028telemetry:\u2028  enabled: true\u2028b: 2c: 3\n",
          "shape": "text"
        }
      }
    }
  ]
}
