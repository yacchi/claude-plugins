{
  "scenario": "telemetry/show-archive-clear",
  "steps": [
    {
      "argv": [
        "telemetry",
        "show"
      ],
      "exit": 0,
      "stdout_shape": "text",
      "stdout": "total records: 4\nby event: {\"dispatch\": 2, \"run_summary\": 1}\nby status: {\"ok\": 1, \"unavailable\": 1}\nby reason: {\"quota\": 1}\n",
      "stderr": ""
    },
    {
      "argv": [
        "telemetry",
        "show",
        "--json"
      ],
      "exit": 0,
      "stdout_shape": "jsonl",
      "stdout": [
        {
          "event": "dispatch",
          "executor": "pi",
          "os": "<OS>",
          "schema_version": 2,
          "status": "ok",
          "ts": "<TS>",
          "usage": {
            "input_tokens": 10,
            "output_tokens": 20
          }
        },
        {
          "event": "dispatch",
          "executor": "claude",
          "os": "<OS>",
          "reason": "quota",
          "schema_version": 2,
          "status": "unavailable",
          "ts": "<TS>"
        },
        [
          1,
          2
        ],
        {
          "event": "run_summary",
          "os": "<OS>",
          "schema_version": 2,
          "task_count": 4,
          "ts": "<TS>"
        }
      ],
      "stderr": ""
    },
    {
      "argv": [
        "telemetry",
        "show",
        "--bogus"
      ],
      "exit": 0,
      "stdout_shape": "text",
      "stdout": "total records: 4\nby event: {\"dispatch\": 2, \"run_summary\": 1}\nby status: {\"ok\": 1, \"unavailable\": 1}\nby reason: {\"quota\": 1}\n",
      "stderr": ""
    },
    {
      "argv": [
        "telemetry",
        "archive",
        "--out",
        "out.tgz"
      ],
      "exit": 0,
      "stdout_shape": "text",
      "stdout": "<WORK>/out.tgz\n",
      "stderr": ""
    },
    {
      "argv": [
        "telemetry",
        "archive",
        "--out"
      ],
      "exit": 2,
      "stdout_shape": "empty",
      "stdout": null,
      "stderr": "agent-exec: telemetry: missing value for --out\n"
    },
    {
      "argv": [
        "telemetry",
        "archive",
        "extra"
      ],
      "exit": 2,
      "stdout_shape": "empty",
      "stdout": null,
      "stderr": "agent-exec: telemetry: unknown option: extra\n"
    },
    {
      "argv": [
        "telemetry",
        "record",
        "--json",
        "{\"event\": \"dispatch\", \"executor\": \"pi\", \"status\": \"ok\"}"
      ],
      "exit": 0,
      "stdout_shape": "empty",
      "stdout": null,
      "stderr": "",
      "files": {
        "~/.claude/orchestra/telemetry/records.jsonl": {
          "content": "{\"event\": \"dispatch\", \"schema_version\": 2, \"ts\": \"<TS>\", \"os\": \"linux\", \"executor\": \"pi\", \"status\": \"ok\", \"usage\": {\"input_tokens\": 10, \"output_tokens\": 20}}\nnot json at all\n\n{\"event\": \"dispatch\", \"schema_version\": 2, \"ts\": \"<TS>\", \"os\": \"linux\", \"executor\": \"claude\", \"status\": \"unavailable\", \"reason\": \"quota\"}\n[1, 2]\n{\"event\": \"run_summary\", \"schema_version\": 2, \"ts\": \"<TS>\", \"os\": \"linux\", \"task_count\": 4}\n{\"event\": \"dispatch\", \"schema_version\": 2, \"ts\": \"<TS>\", \"os\": \"darwin\", \"executor\": \"pi\", \"status\": \"ok\"}\n",
          "shape": "text"
        }
      }
    },
    {
      "argv": [
        "telemetry",
        "show"
      ],
      "exit": 0,
      "stdout_shape": "text",
      "stdout": "total records: 5\nby event: {\"dispatch\": 3, \"run_summary\": 1}\nby status: {\"ok\": 2, \"unavailable\": 1}\nby reason: {\"quota\": 1}\n",
      "stderr": ""
    },
    {
      "argv": [
        "telemetry",
        "clear"
      ],
      "exit": 0,
      "stdout_shape": "empty",
      "stdout": null,
      "stderr": "",
      "files": {
        "~/.claude/orchestra/telemetry/records.jsonl": null
      }
    },
    {
      "argv": [
        "telemetry",
        "show"
      ],
      "exit": 0,
      "stdout_shape": "text",
      "stdout": "total records: 0\nby event: {}\nby status: {}\nby reason: {}\n",
      "stderr": ""
    },
    {
      "argv": [
        "telemetry",
        "clear",
        "whatever"
      ],
      "exit": 0,
      "stdout_shape": "empty",
      "stdout": null,
      "stderr": ""
    }
  ]
}
