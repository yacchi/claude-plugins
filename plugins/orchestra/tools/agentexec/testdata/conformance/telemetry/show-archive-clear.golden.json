{
  "scenario": "telemetry/show-archive-clear",
  "steps": [
    {
      "argv": [
        "telemetry",
        "show"
      ],
      "exit": 0,
      "stdout_shape": "text",
      "stdout": "total records: 4\nby event: {\"dispatch\":2,\"run_summary\":1}\nby status: {\"ok\":1,\"unavailable\":1}\nby reason: {\"quota\":1}\n"
    },
    {
      "argv": [
        "telemetry",
        "show",
        "--json"
      ],
      "exit": 0,
      "stdout_shape": "jsonl",
      "stdout": [
        {
          "event": "dispatch",
          "executor": "pi",
          "os": "<OS>",
          "schema_version": 2,
          "status": "ok",
          "ts": "<TS>",
          "usage": {
            "input_tokens": 10,
            "output_tokens": 20
          }
        },
        {
          "event": "dispatch",
          "executor": "claude",
          "os": "<OS>",
          "reason": "quota",
          "schema_version": 2,
          "status": "unavailable",
          "ts": "<TS>"
        },
        [
          1,
          2
        ],
        {
          "event": "run_summary",
          "os": "<OS>",
          "schema_version": 2,
          "task_count": 4,
          "ts": "<TS>"
        }
      ]
    },
    {
      "argv": [
        "telemetry",
        "archive",
        "--out",
        "out.tgz"
      ],
      "exit": 0,
      "stdout_shape": "text",
      "stdout": "<WORK>/out.tgz\n"
    },
    {
      "argv": [
        "telemetry",
        "record",
        "--json",
        "{\"event\": \"dispatch\", \"executor\": \"pi\", \"status\": \"ok\"}"
      ],
      "exit": 0,
      "stdout_shape": "empty",
      "stdout": null,
      "files": {
        "~/.claude/orchestra/telemetry/records.jsonl": {
          "content": "{\"event\": \"dispatch\", \"schema_version\": 2, \"ts\": \"<TS>\", \"os\": \"linux\", \"executor\": \"pi\", \"status\": \"ok\", \"usage\": {\"input_tokens\": 10, \"output_tokens\": 20}}\nnot json at all\n\n{\"event\": \"dispatch\", \"schema_version\": 2, \"ts\": \"<TS>\", \"os\": \"linux\", \"executor\": \"claude\", \"status\": \"unavailable\", \"reason\": \"quota\"}\n[1, 2]\n{\"event\": \"run_summary\", \"schema_version\": 2, \"ts\": \"<TS>\", \"os\": \"linux\", \"task_count\": 4}\n{\"event\":\"dispatch\",\"executor\":\"pi\",\"os\":\"darwin\",\"schema_version\":2,\"status\":\"ok\",\"ts\":\"<TS>\"}\n",
          "shape": "text"
        }
      }
    },
    {
      "argv": [
        "telemetry",
        "show"
      ],
      "exit": 0,
      "stdout_shape": "text",
      "stdout": "total records: 5\nby event: {\"dispatch\":3,\"run_summary\":1}\nby status: {\"ok\":2,\"unavailable\":1}\nby reason: {\"quota\":1}\n"
    },
    {
      "argv": [
        "telemetry",
        "clear"
      ],
      "exit": 0,
      "stdout_shape": "empty",
      "stdout": null,
      "files": {
        "~/.claude/orchestra/telemetry/records.jsonl": null
      }
    },
    {
      "argv": [
        "telemetry",
        "show"
      ],
      "exit": 0,
      "stdout_shape": "text",
      "stdout": "total records: 0\nby event: {}\nby status: {}\nby reason: {}\n"
    }
  ]
}
