{
  "scenario": "telemetry/toggle-errors",
  "steps": [
    {
      "argv": [
        "telemetry",
        "disable",
        "--scope",
        "global"
      ],
      "exit": 2,
      "stdout_shape": "empty",
      "stdout": null,
      "files": {
        "~/.claude/orchestra.yaml": null
      }
    },
    {
      "argv": [
        "telemetry",
        "enable",
        "--bogus"
      ],
      "exit": 2,
      "stdout_shape": "empty",
      "stdout": null,
      "files": {
        "~/.claude/orchestra.yaml": null
      }
    },
    {
      "argv": [
        "telemetry"
      ],
      "exit": 2,
      "stdout_shape": "empty",
      "stdout": null
    },
    {
      "argv": [
        "telemetry",
        "nope"
      ],
      "exit": 2,
      "stdout_shape": "empty",
      "stdout": null
    }
  ]
}
