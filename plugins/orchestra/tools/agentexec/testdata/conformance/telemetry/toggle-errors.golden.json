{
  "scenario": "telemetry/toggle-errors",
  "steps": [
    {
      "argv": [
        "telemetry",
        "enable",
        "--scope"
      ],
      "exit": 2,
      "stdout_shape": "empty",
      "stdout": null,
      "stderr": "agent-exec: telemetry: missing value for --scope\n",
      "files": {
        "~/.claude/orchestra.yaml": null
      }
    },
    {
      "argv": [
        "telemetry",
        "disable",
        "--scope",
        "global"
      ],
      "exit": 2,
      "stdout_shape": "empty",
      "stdout": null,
      "stderr": "agent-exec: telemetry: invalid --scope: global\n",
      "files": {
        "~/.claude/orchestra.yaml": null
      }
    },
    {
      "argv": [
        "telemetry",
        "enable",
        "--bogus"
      ],
      "exit": 2,
      "stdout_shape": "empty",
      "stdout": null,
      "stderr": "agent-exec: telemetry: unknown option: --bogus\n",
      "files": {
        "~/.claude/orchestra.yaml": null
      }
    },
    {
      "argv": [
        "telemetry",
        "enable",
        "extra"
      ],
      "exit": 2,
      "stdout_shape": "empty",
      "stdout": null,
      "stderr": "agent-exec: telemetry: unknown option: extra\n",
      "files": {
        "~/.claude/orchestra.yaml": null
      }
    },
    {
      "argv": [
        "telemetry"
      ],
      "exit": 2,
      "stdout_shape": "empty",
      "stdout": null,
      "stderr": "agent-exec: telemetry: missing subcommand\n"
    },
    {
      "argv": [
        "telemetry",
        "nope"
      ],
      "exit": 2,
      "stdout_shape": "empty",
      "stdout": null,
      "stderr": "agent-exec: telemetry: unknown subcommand: nope\n"
    }
  ]
}
