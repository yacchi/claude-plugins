{
  "scenario": "shelf/usage",
  "steps": [
    {
      "argv": [
        "shelf"
      ],
      "exit": 2,
      "stdout_shape": "empty",
      "stdout": null
    },
    {
      "argv": [
        "shelf",
        "stash"
      ],
      "exit": 2,
      "stdout_shape": "empty",
      "stdout": null
    },
    {
      "argv": [
        "shelf",
        "push",
        "--bogus"
      ],
      "exit": 2,
      "stdout_shape": "empty",
      "stdout": null
    },
    {
      "argv": [
        "shelf",
        "pop",
        "x"
      ],
      "exit": 2,
      "stdout_shape": "empty",
      "stdout": null
    },
    {
      "argv": [
        "shelf",
        "list",
        "--repo",
        "<ROOT>/tmp"
      ],
      "exit": 3,
      "stdout_shape": "json",
      "stdout": {
        "reason": "not a git repository",
        "status": "error"
      }
    },
    {
      "argv": [
        "shelf",
        "push",
        "--repo",
        "<ROOT>/tmp",
        "--allow-main-tree"
      ],
      "exit": 3,
      "stdout_shape": "json",
      "stdout": {
        "reason": "not a git repository",
        "status": "error"
      }
    }
  ]
}
