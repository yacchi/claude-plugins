{
  "scenario": "sandbox/allow-forget",
  "steps": [
    {
      "argv": [
        "sandbox",
        "allow",
        "~/data"
      ],
      "exit": 0,
      "stdout_shape": "text",
      "stdout": "granted: <HOME>/data\n",
      "files": {
        "~/.local/state/claude-orchestra/sandbox-learned.json": {
          "content": {
            "grants": [
              {
                "added": "<TS>",
                "example": "<HOME>/data",
                "path": "<HOME>/data",
                "source": "user"
              }
            ],
            "version": 1
          },
          "shape": "json"
        }
      }
    },
    {
      "argv": [
        "sandbox",
        "allow",
        "--json",
        "--reason",
        "fixtures for the tests",
        "~/data/sub"
      ],
      "exit": 0,
      "stdout_shape": "json",
      "stdout": {
        "added": "<TS>",
        "example": "<HOME>/data/sub",
        "path": "<HOME>/data/sub",
        "reason": "fixtures for the tests",
        "source": "user"
      }
    },
    {
      "argv": [
        "sandbox",
        "allow",
        "~/data",
        "--json"
      ],
      "exit": 0,
      "stdout_shape": "json",
      "stdout": {
        "added": "<TS>",
        "example": "<HOME>/data",
        "path": "<HOME>/data",
        "source": "user"
      }
    },
    {
      "argv": [
        "sandbox",
        "allow",
        "~/new-dir/./x/..",
        "--reason",
        ""
      ],
      "exit": 0,
      "stdout_shape": "text",
      "stdout": "granted: <HOME>/new-dir\n",
      "files": {
        "~/.local/state/claude-orchestra/sandbox-learned.json": {
          "content": {
            "grants": [
              {
                "added": "<TS>",
                "example": "<HOME>/data",
                "path": "<HOME>/data",
                "source": "user"
              },
              {
                "added": "<TS>",
                "example": "<HOME>/data/sub",
                "path": "<HOME>/data/sub",
                "reason": "fixtures for the tests",
                "source": "user"
              },
              {
                "added": "<TS>",
                "example": "<HOME>/new-dir",
                "path": "<HOME>/new-dir",
                "source": "user"
              }
            ],
            "version": 1
          },
          "shape": "json"
        }
      }
    },
    {
      "argv": [
        "sandbox",
        "allow",
        "/"
      ],
      "exit": 1,
      "stdout_shape": "empty",
      "stdout": null
    },
    {
      "argv": [
        "sandbox",
        "allow",
        "~"
      ],
      "exit": 1,
      "stdout_shape": "empty",
      "stdout": null
    },
    {
      "argv": [
        "sandbox",
        "allow",
        "~/.claude/plugins"
      ],
      "exit": 1,
      "stdout_shape": "empty",
      "stdout": null
    },
    {
      "argv": [
        "sandbox",
        "allow",
        "~/.ssh/keys"
      ],
      "exit": 1,
      "stdout_shape": "empty",
      "stdout": null
    },
    {
      "argv": [
        "sandbox",
        "allow",
        "~/secrets/a"
      ],
      "exit": 1,
      "stdout_shape": "empty",
      "stdout": null
    },
    {
      "argv": [
        "sandbox",
        "allow",
        "~/.local/share/uv/tools/x"
      ],
      "exit": 1,
      "stdout_shape": "empty",
      "stdout": null
    },
    {
      "argv": [
        "sandbox",
        "allow",
        "~/.local"
      ],
      "exit": 1,
      "stdout_shape": "empty",
      "stdout": null
    },
    {
      "argv": [
        "sandbox",
        "allow",
        "~/.local/state/claude-orchestra"
      ],
      "exit": 1,
      "stdout_shape": "empty",
      "stdout": null
    },
    {
      "argv": [
        "sandbox",
        "forget",
        "~/data/sub",
        "--json"
      ],
      "exit": 0,
      "stdout_shape": "json",
      "stdout": {
        "path": "<HOME>/data/sub",
        "removed": true
      }
    },
    {
      "argv": [
        "sandbox",
        "forget",
        "~/data/sub",
        "--json"
      ],
      "exit": 1,
      "stdout_shape": "json",
      "stdout": {
        "path": "<HOME>/data/sub",
        "removed": false
      }
    },
    {
      "argv": [
        "sandbox",
        "forget",
        "~/data"
      ],
      "exit": 0,
      "stdout_shape": "text",
      "stdout": "removed: <HOME>/data\n"
    },
    {
      "argv": [
        "sandbox",
        "forget",
        "~/data"
      ],
      "exit": 1,
      "stdout_shape": "text",
      "stdout": "no grant for: <HOME>/data\n"
    }
  ]
}
