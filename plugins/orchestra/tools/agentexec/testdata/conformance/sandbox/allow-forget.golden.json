{
  "scenario": "sandbox/allow-forget",
  "steps": [
    {
      "argv": [
        "sandbox",
        "allow",
        "~/data"
      ],
      "exit": 0,
      "stdout_shape": "text",
      "stdout": "granted: <HOME>/data\n",
      "stderr": "",
      "files": {
        "~/.local/state/claude-orchestra/sandbox-learned.json": {
          "content": {
            "grants": [
              {
                "added": "<TS>",
                "example": "<HOME>/data",
                "path": "<HOME>/data",
                "source": "user"
              }
            ],
            "version": 1
          },
          "shape": "json-indent"
        }
      }
    },
    {
      "argv": [
        "sandbox",
        "allow",
        "--json",
        "--reason",
        "fixtures for the tests",
        "~/data/sub"
      ],
      "exit": 0,
      "stdout_shape": "json-line",
      "stdout": {
        "added": "<TS>",
        "example": "<HOME>/data/sub",
        "path": "<HOME>/data/sub",
        "reason": "fixtures for the tests",
        "source": "user"
      },
      "stderr": ""
    },
    {
      "argv": [
        "sandbox",
        "allow",
        "~/data",
        "--json"
      ],
      "exit": 0,
      "stdout_shape": "json-line",
      "stdout": {
        "added": "<TS>",
        "example": "<HOME>/data",
        "path": "<HOME>/data",
        "source": "user"
      },
      "stderr": ""
    },
    {
      "argv": [
        "sandbox",
        "allow",
        "~/new-dir/./x/..",
        "--reason",
        ""
      ],
      "exit": 0,
      "stdout_shape": "text",
      "stdout": "granted: <HOME>/new-dir\n",
      "stderr": "",
      "files": {
        "~/.local/state/claude-orchestra/sandbox-learned.json": {
          "content": {
            "grants": [
              {
                "added": "<TS>",
                "example": "<HOME>/data",
                "path": "<HOME>/data",
                "source": "user"
              },
              {
                "added": "<TS>",
                "example": "<HOME>/data/sub",
                "path": "<HOME>/data/sub",
                "reason": "fixtures for the tests",
                "source": "user"
              },
              {
                "added": "<TS>",
                "example": "<HOME>/new-dir",
                "path": "<HOME>/new-dir",
                "source": "user"
              }
            ],
            "version": 1
          },
          "shape": "json-indent"
        }
      }
    },
    {
      "argv": [
        "sandbox",
        "allow",
        "/"
      ],
      "exit": 1,
      "stdout_shape": "empty",
      "stdout": null,
      "stderr": "agent-exec: sandbox allow: refusing to grant /\n"
    },
    {
      "argv": [
        "sandbox",
        "allow",
        "~"
      ],
      "exit": 1,
      "stdout_shape": "empty",
      "stdout": null,
      "stderr": "agent-exec: sandbox allow: refusing to grant the home directory itself\n"
    },
    {
      "argv": [
        "sandbox",
        "allow",
        "~/.claude/plugins"
      ],
      "exit": 1,
      "stdout_shape": "empty",
      "stdout": null,
      "stderr": "agent-exec: sandbox allow: refusing to grant anything under ~/.claude\n"
    },
    {
      "argv": [
        "sandbox",
        "allow",
        "~/.ssh/keys"
      ],
      "exit": 1,
      "stdout_shape": "empty",
      "stdout": null,
      "stderr": "agent-exec: sandbox allow: path overlaps deny_read entry <HOME>/.ssh\n"
    },
    {
      "argv": [
        "sandbox",
        "allow",
        "~/secrets/a"
      ],
      "exit": 1,
      "stdout_shape": "empty",
      "stdout": null,
      "stderr": "agent-exec: sandbox allow: path overlaps deny_read entry <HOME>/secrets\n"
    },
    {
      "argv": [
        "sandbox",
        "allow",
        "~/.local/share/uv/tools/x"
      ],
      "exit": 1,
      "stdout_shape": "empty",
      "stdout": null,
      "stderr": "agent-exec: sandbox allow: path overlaps tamper-protected <HOME>/.local/share/uv/tools\n"
    },
    {
      "argv": [
        "sandbox",
        "allow",
        "~/.local"
      ],
      "exit": 1,
      "stdout_shape": "empty",
      "stdout": null,
      "stderr": "agent-exec: sandbox allow: path overlaps tamper-protected <HOME>/.local/share/uv/tools\n"
    },
    {
      "argv": [
        "sandbox",
        "allow",
        "~/.local/state/claude-orchestra"
      ],
      "exit": 1,
      "stdout_shape": "empty",
      "stdout": null,
      "stderr": "agent-exec: sandbox allow: path overlaps tamper-protected <HOME>/.local/state/claude-orchestra/sandbox-learned.json\n"
    },
    {
      "argv": [
        "sandbox",
        "allow"
      ],
      "exit": 2,
      "stdout_shape": "empty",
      "stdout": null,
      "stderr": "agent-exec: sandbox allow: expected one path\n"
    },
    {
      "argv": [
        "sandbox",
        "allow",
        "~/a",
        "~/b"
      ],
      "exit": 2,
      "stdout_shape": "empty",
      "stdout": null,
      "stderr": "agent-exec: sandbox allow: expected one path\n"
    },
    {
      "argv": [
        "sandbox",
        "allow",
        "~/data",
        "--reason"
      ],
      "exit": 2,
      "stdout_shape": "empty",
      "stdout": null,
      "stderr": "agent-exec: sandbox allow: missing value for --reason\n"
    },
    {
      "argv": [
        "sandbox",
        "forget",
        "~/data/sub",
        "--json"
      ],
      "exit": 0,
      "stdout_shape": "json-line",
      "stdout": {
        "path": "<HOME>/data/sub",
        "removed": true
      },
      "stderr": ""
    },
    {
      "argv": [
        "sandbox",
        "forget",
        "~/data/sub",
        "--json"
      ],
      "exit": 1,
      "stdout_shape": "json-line",
      "stdout": {
        "path": "<HOME>/data/sub",
        "removed": false
      },
      "stderr": ""
    },
    {
      "argv": [
        "sandbox",
        "forget",
        "~/data"
      ],
      "exit": 0,
      "stdout_shape": "text",
      "stdout": "removed: <HOME>/data\n",
      "stderr": ""
    },
    {
      "argv": [
        "sandbox",
        "forget",
        "~/data"
      ],
      "exit": 1,
      "stdout_shape": "text",
      "stdout": "no grant for: <HOME>/data\n",
      "stderr": ""
    },
    {
      "argv": [
        "sandbox",
        "forget"
      ],
      "exit": 2,
      "stdout_shape": "empty",
      "stdout": null,
      "stderr": "agent-exec: sandbox forget: expected one path\n",
      "files": {
        "~/.local/state/claude-orchestra/sandbox-learned.json": {
          "content": {
            "grants": [
              {
                "added": "<TS>",
                "example": "<HOME>/new-dir",
                "path": "<HOME>/new-dir",
                "source": "user"
              }
            ],
            "version": 1
          },
          "shape": "json-indent"
        }
      }
    },
    {
      "argv": [
        "sandbox",
        "frobnicate"
      ],
      "exit": 2,
      "stdout_shape": "empty",
      "stdout": null,
      "stderr": "agent-exec: sandbox: unknown subcommand: frobnicate\n"
    }
  ]
}
