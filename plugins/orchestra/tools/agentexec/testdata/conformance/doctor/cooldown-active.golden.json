            "class": "deep",
            "cooldown_bypassed": false,
            "cooldowns_applied": [],
            "dispatch": "claude",
            "effort": "medium",
            "executor": "claude",
            "model": "opus",
            "remaining": [
              "pi"
            ],
            "skipped": [],
            "source": "priority",
            "usage_applied": [],
            "usage_bypassed": false
          },
          "light": {
            "agent_type": "orchestra:orchestra-light",
            "archetype": "default",
            "candidates": [
              "claude",
              "pi"
