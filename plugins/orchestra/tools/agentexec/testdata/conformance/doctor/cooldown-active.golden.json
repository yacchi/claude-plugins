        "executors": {
          "pi": {
            "available": true,
            "binary": "pi",
            "dispatch": "cli",
            "enabled": true,
            "hint": "run: agent-exec tools install pi",
            "login": {
              "openai-codex": true
            },
            "path": "<ROOT>/bin/pi",
            "source": "system",
            "tool_version": null
          }
        },
        "herdr_host": {
          "backend": "none",
          "home": "/private/tmp/orchestra-501/hx",
          "network": {
            "allowed_domains": [
              "api.anthropic.com"
            ],
            "mode": "allowlist",
            "reason": "network not restricted: host not sandboxed: sandbox.mode is off",
            "restricted": false,
            "srt": {
              "path": null,
              "reason": "srt not found (not-installed)",
              "version": null
            }
          },
          "reason": "sandbox.mode is off",
          "sandboxed": false
        },
        "permission": {
          "best_effort_note": "best-effort scan of ~/.claude/settings.json and ./.claude/settings.json(.local); does not see enterprise policy or CLI --allowedTools",
          "found": true,
          "rule": "Bash(agent-exec:*)",
          "sources": [
            "<HOME>/.claude/settings.json"
          ]
        },
        "ready": {
          "pi": {
            "missing": [],
            "ok": true
          }
        },
        "route": {
          "deep": {
            "agent_type": "orchestra:orchestra-deep",
            "archetype": "default",
            "candidates": [
              "claude",
              "pi"
