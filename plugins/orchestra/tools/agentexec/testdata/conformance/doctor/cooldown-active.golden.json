                "mode": "allowlist",
                "quiet_domains": [
                  "mcp-proxy.anthropic.com",
                  "downloads.claude.ai",
                  "statsig.anthropic.com",
                  "datadoghq.com",
                  "*.datadoghq.com",
                  "sentry.io",
                  "*.sentry.io",
