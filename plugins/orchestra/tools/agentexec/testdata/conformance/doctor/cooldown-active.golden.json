{
  "scenario": "doctor/cooldown-active",
  "steps": [
    {
      "argv": [
        "doctor"
      ],
      "exit": 0,
      "stdout_shape": "json",
      "stdout": {
        "build": {
          "binary": "<BUILD>",
          "go": "<BUILD>",
          "source_hash": "<BUILD>"
        },
        "cli_network": {
          "ecosystem": true,
          "executors": {
            "pi": {
              "backend": "none",
              "domains": [
                "chatgpt.com",
                "auth.openai.com"
              ],
              "reason": "sandbox.mode is off",
              "restricted": false
            }
          },
          "mode": "allowlist",
          "preset_domains": []
        },
        "config": {
          "config_root": "<WORK>",
          "error": null,
          "layers_found": [
            "<HOME>/.claude/orchestra.yaml",
            "<WORK>/.claude/orchestra.yaml"
          ],
          "resolved": true,
          "values": {
            "checks": {
              "ensure": [],
              "flaky_threshold": 3,
              "items": [],
              "max_parallel": 2,
              "retry_failed_alone": true
            },
            "cooldown": {
              "enabled": true,
              "path": "~/.claude/orchestra/executor-state.json",
              "seconds": {
                "auth": 0,
                "credits": 3600,
                "nonzero-exit": 0,
                "quota": 3600,
                "rate-limit": 900,
                "sandbox": 0
              }
            },
            "enforcement": {
              "light_class": "off",
              "opus_generalist": "nudge",
              "session_cleanup": "on",
              "turn_edits": 8,
              "worker_vcs": "block"
