            },
            "wave": {
              "budget_usd": 0,
              "max_in_flight": "auto",
              "memory_guard": true,
              "usage_every": 10
            }
          },
          "warnings": []
        },
        "cooldowns": {
          "active": {
            "pi": {
              "reason": "quota",
              "until": 4102444800.5
