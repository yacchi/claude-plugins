            "class": "review",
            "cooldown_bypassed": false,
            "cooldowns_applied": [],
            "dispatch": "claude",
            "effort": "medium",
            "executor": "claude",
            "model": "sonnet",
            "remaining": [],
            "skipped": [],
            "source": "priority",
            "usage_applied": [],
