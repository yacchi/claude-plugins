              "command": "claude --model {model} --permission-mode {permission_mode}",
              "enabled": "auto",
              "keep_sessions": true,
              "models": {
                "deep": "opus",
                "light": "sonnet",
                "standard": "opus"
              },
              "permission_mode": "auto",
              "setup": "skip",
              "startup_timeout": 90,
              "task_timeout": 3600,
              "user_config": "isolate"
            },
            "priority": {
