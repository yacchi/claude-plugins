              "permission_mode": "auto",
              "startup_timeout": 90,
              "task_timeout": 3600,
              "user_config": "isolate",
              "warm": {
                "enabled": true,
                "min_packages": 2,
                "ttl_seconds": 3000
              }
            },
            "interactive_host": "auto",
            "isolation": {
              "carry_extra": [],
