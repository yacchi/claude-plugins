              "review": {
                "effort": "medium",
                "model": "sonnet"
              },
              "standard": {
                "effort": "high",
                "model": "haiku"
              }
            },
            "tools": {
              "herdr": {
                "bin": "herdr",
                "source": "auto",
                "spec": "aqua:herdrdev/herdr",
                "version": "0.8.2"
              },
              "installer": "auto",
              "pi": {
                "bin": "pi",
                "source": "auto",
                "spec": "npm:@earendil-works/pi-coding-agent",
