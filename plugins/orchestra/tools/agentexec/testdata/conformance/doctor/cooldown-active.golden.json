            "external_executors": {
              "pi": {
                "agent_dir": "managed",
                "available": true,
                "class_policy": {
                  "deep": {
                    "effort": "high",
                    "model": "openai-codex/gpt-6.1-sol"
                  },
                  "independent-review": {
                    "effort": "medium",
                    "model": "openai-codex/gpt-6.1-sol"
                  },
                  "light": {
                    "effort": "medium",
                    "model": "openai-codex/gpt-5.6-luna"
                  },
                  "standard": {
                    "effort": "high",
                    "model": "openai-codex/gpt-5.6-luna"
                  }
