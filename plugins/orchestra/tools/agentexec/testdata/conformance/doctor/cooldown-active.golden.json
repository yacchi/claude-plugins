                  "standard",
                  "deep",
                  "independent-review"
                ],
                "context_files": true,
                "dispatch": "cli",
                "enabled": true
              }
            },
            "herdr": {
              "add_dirs": [],
              "args": "--model {model} --permission-mode {permission_mode}",
              "auto_trust": true,
              "enabled": "auto",
              "keep_sessions": true,
              "models": {
                "deep": "opus",
                "light": "sonnet",
                "standard": "opus"
