{
  "scenario": "wave-run/usage",
  "steps": [
    {
      "argv": [
        "wave"
      ],
      "exit": 2,
      "stdout_shape": "empty",
      "stdout": null
    },
    {
      "argv": [
        "wave",
        "bogus"
      ],
      "exit": 2,
      "stdout_shape": "empty",
      "stdout": null
    },
    {
      "argv": [
        "wave",
        "run"
      ],
      "exit": 2,
      "stdout_shape": "empty",
      "stdout": null
    },
    {
      "argv": [
        "wave",
        "run",
        "--plan",
        "p",
        "--state",
        "s",
        "--into",
        "i",
        "--bogus"
      ],
      "exit": 2,
      "stdout_shape": "empty",
      "stdout": null
    },
    {
      "argv": [
        "wave",
        "run",
        "--plan",
        "p",
        "--state",
        "s",
        "--into",
        "i",
        "--max-in-flight",
        "0"
      ],
      "exit": 2,
      "stdout_shape": "empty",
      "stdout": null
    },
    {
      "argv": [
        "wave",
        "run",
        "--plan",
        "p",
        "--state",
        "s",
        "--into",
        "i",
        "--run-id",
        "bad id"
      ],
      "exit": 2,
      "stdout_shape": "empty",
      "stdout": null
    },
    {
      "argv": [
        "wave",
        "run",
        "--plan",
        "missing.json",
        "--state",
        "s.json",
        "--into",
        "i"
      ],
      "exit": 2,
      "stdout_shape": "json",
      "stdout": {
        "kind": "plan",
        "reason": "cannot read plan missing.json: open missing.json: no such file or directory",
        "status": "error"
      }
    },
    {
      "argv": [
        "wave",
        "run",
        "--plan",
        "plan.json",
        "--state",
        "s.json",
        "--into",
        "i",
        "--text"
      ],
      "exit": 3,
      "stdout_shape": "text",
      "stdout": "wave run error: not a git repository: <WORK>\n"
    },
    {
      "argv": [
        "wave",
        "run",
        "--plan",
        "plan.json",
        "--state",
        "s.json",
        "--into",
        "i",
        "--repo",
        "."
      ],
      "exit": 3,
      "stdout_shape": "json",
      "stdout": {
        "kind": "environment",
        "reason": "not a git repository: .",
        "status": "error"
      }
    },
    {
      "argv": [
        "wave",
        "mark"
      ],
      "exit": 2,
      "stdout_shape": "empty",
      "stdout": null
    }
  ]
}
