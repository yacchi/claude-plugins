{
  "scenario": "ui/pilogin-cancel",
  "steps": [
    {
      "argv": [
        "pi",
        "login",
        "--provider",
        "anthropic"
      ],
      "exit": 0,
      "stdout_shape": "json",
      "stdout": {
        "method": "browser",
        "paste_prompt": true,
        "provider": "anthropic",
        "session": "<SESSION>",
        "status": "waiting",
        "url": "https://auth.example.com/oauth/authorize?client_id=abc&state=xyz"
      }
    },
    {
      "argv": [
        "pi",
        "login",
        "--cancel"
      ],
      "exit": 0,
      "stdout_shape": "json",
      "stdout": {
        "status": "cancelled"
      }
    },
    {
      "argv": [
        "pi",
        "login",
        "--wait",
        "--timeout",
        "1"
      ],
      "exit": 1,
      "stdout_shape": "json",
      "stdout": {
        "reason": "no login in progress (run `agent-exec pi login` first)",
        "screen_tail": "",
        "status": "failed"
      }
    }
  ]
}
