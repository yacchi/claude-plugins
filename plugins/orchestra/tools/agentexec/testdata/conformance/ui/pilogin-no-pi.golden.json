{
  "scenario": "ui/pilogin-no-pi",
  "steps": [
    {
      "argv": [
        "pi",
        "login",
        "--json"
      ],
      "exit": 1,
      "stdout_shape": "json",
      "stdout": {
        "reason": "pi is not installed: run `agent-exec tools install pi`",
        "screen_tail": "",
        "status": "manual",
        "step": "pi-not-found"
      }
    },
    {
      "argv": [
        "pi",
        "login",
        "--provider",
        "anthropic"
      ],
      "exit": 1,
      "stdout_shape": "json",
      "stdout": {
        "reason": "pi is not installed: run `agent-exec tools install pi`",
        "screen_tail": "",
        "status": "manual",
        "step": "pi-not-found"
      }
    },
    {
      "argv": [
        "pi",
        "login",
        "--wait",
        "--timeout",
        "1"
      ],
      "exit": 1,
      "stdout_shape": "json",
      "stdout": {
        "reason": "no login in progress (run `agent-exec pi login` first)",
        "screen_tail": "",
        "status": "failed"
      }
    },
    {
      "argv": [
        "pi",
        "login",
        "--paste",
        "http://localhost:1455/cb?code=x"
      ],
      "exit": 1,
      "stdout_shape": "json",
      "stdout": {
        "reason": "no login in progress (run `agent-exec pi login` first)",
        "screen_tail": "",
        "status": "failed"
      }
    },
    {
      "argv": [
        "pi",
        "login",
        "--cancel"
      ],
      "exit": 0,
      "stdout_shape": "json",
      "stdout": {
        "status": "cancelled"
      }
    }
  ]
}
