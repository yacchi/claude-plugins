{
  "scenario": "ui/pilogin-no-herdr",
  "steps": [
    {
      "argv": [
        "pi",
        "login"
      ],
      "exit": 1,
      "stdout_shape": "json",
      "stdout": {
        "reason": "herdr is not configured (binary or session name missing)",
        "screen_tail": "",
        "status": "manual",
        "step": "herdr"
      }
    },
    {
      "argv": [
        "pi",
        "login",
        "--provider",
        "anthropic"
      ],
      "exit": 1,
      "stdout_shape": "json",
      "stdout": {
        "reason": "herdr is not configured (binary or session name missing)",
        "screen_tail": "",
        "status": "manual",
        "step": "herdr"
      }
    },
    {
      "argv": [
        "pi",
        "login",
        "--provider",
        "nonesuch"
      ],
      "exit": 1,
      "stdout_shape": "json",
      "stdout": {
        "reason": "no known /login label for provider nonesuch",
        "screen_tail": "",
        "status": "manual",
        "step": "provider"
      }
    },
    {
      "argv": [
        "pi",
        "login",
        "--cancel"
      ],
      "exit": 0,
      "stdout_shape": "json",
