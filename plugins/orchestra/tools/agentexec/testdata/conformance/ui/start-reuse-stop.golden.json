{
  "scenario": "ui/start-reuse-stop",
  "steps": [
    {
      "argv": [
        "ui",
        "--json"
      ],
      "exit": 0,
      "stdout_shape": "json",
      "stdout": {
        "pid": "<PID>",
        "reused": false,
        "url": "<URL>"
      }
    },
    {
      "argv": [
        "ui",
        "--json"
      ],
      "exit": 0,
      "stdout_shape": "json",
      "stdout": {
        "pid": "<PID>",
        "reused": true,
        "url": "<URL>"
      }
    },
    {
      "argv": [
        "ui",
        "--stop",
        "--json"
      ],
      "exit": 0,
      "stdout_shape": "json",
      "stdout": {
        "stopped": true
      }
    },
    {
      "argv": [
        "ui",
        "--stop",
        "--json"
      ],
      "exit": 0,
      "stdout_shape": "json",
      "stdout": {
        "stopped": false
      }
    },
    {
      "argv": [
        "ui",
        "--stop"
      ],
      "exit": 0,
      "stdout_shape": "text",
      "stdout": "not running\n"
    }
  ]
}
