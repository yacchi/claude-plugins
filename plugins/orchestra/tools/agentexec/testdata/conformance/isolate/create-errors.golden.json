{
  "scenario": "isolate/create-errors",
  "steps": [
    {
      "argv": [
        "isolate",
        "create"
      ],
      "exit": 2,
      "stdout_shape": "empty",
      "stdout": null,
      "stderr": "agent-exec: isolate create: missing required option: --task\n"
    },
    {
      "argv": [
        "isolate",
        "diff"
      ],
      "exit": 2,
      "stdout_shape": "empty",
      "stdout": null,
      "stderr": "agent-exec: isolate diff: missing required option: --task\n"
    },
    {
      "argv": [
        "isolate",
        "create",
        "--task"
      ],
      "exit": 2,
      "stdout_shape": "empty",
      "stdout": null,
      "stderr": "agent-exec: isolate: missing value for --task\n"
    },
    {
      "argv": [
        "isolate",
        "create",
        "--task",
        "t1",
        "--bogus"
      ],
      "exit": 2,
      "stdout_shape": "empty",
      "stdout": null,
      "stderr": "agent-exec: isolate: unknown option: --bogus\n"
    },
    {
      "argv": [
        "isolate",
        "create",
        "--task",
        "t1",
        "extra"
      ],
      "exit": 2,
      "stdout_shape": "empty",
      "stdout": null,
      "stderr": "agent-exec: isolate: unknown option: extra\n"
    },
    {
      "argv": [
        "isolate",
        "create",
        "--task",
        "t1",
        "--backend",
        "svn"
      ],
      "exit": 2,
      "stdout_shape": "empty",
      "stdout": null,
      "stderr": "agent-exec: isolate: unknown backend: svn\n"
    },
    {
      "argv": [
        "isolate",
        "create",
        "--task",
        "t1",
        "--session",
        "abc"
      ],
      "exit": 2,
      "stdout_shape": "empty",
      "stdout": null,
      "stderr": "agent-exec: isolate create: --session is not supported\n"
    },
    {
      "argv": [
        "isolate",
        "diff",
        "--task",
        "t1",
        "--session",
        "abc"
      ],
      "exit": 2,
      "stdout_shape": "empty",
      "stdout": null,
      "stderr": "agent-exec: isolate diff: --session is not supported\n"
    },
    {
      "argv": [
        "isolate",
        "remove"
      ],
      "exit": 2,
      "stdout_shape": "empty",
      "stdout": null,
      "stderr": "agent-exec: isolate remove: provide exactly one of --task or --session\n"
    },
    {
      "argv": [
        "isolate",
        "remove",
        "--task",
        "t1",
        "--session",
        "abcdefgh"
      ],
      "exit": 2,
      "stdout_shape": "empty",
      "stdout": null,
      "stderr": "agent-exec: isolate remove: provide exactly one of --task or --session\n"
    },
    {
      "argv": [
        "isolate",
        "create",
        "--task",
        "///"
      ],
      "exit": 2,
      "stdout_shape": "empty",
      "stdout": null,
      "stderr": "agent-exec: isolate: task id '///' has no usable characters\n"
    },
    {
      "argv": [
        "isolate",
        "create",
        "--task",
        ".."
      ],
      "exit": 2,
      "stdout_shape": "empty",
      "stdout": null,
      "stderr": "agent-exec: isolate: task id '..' has no usable characters\n"
    },
    {
      "argv": [
        "isolate",
        "create",
        "--task",
        "../Foo Bar//x"
      ],
      "exit": 0,
      "stdout_shape": "json-line",
      "stdout": {
        "backend": "git",
        "baseline": "<SHA#1>",
        "branch": "orchestra/00000000/Foo-Bar-x",
        "carried": [],
        "carried_files": [],
        "carry_method": "none",
        "path": "<WORK>-orchestra/00000000-Foo-Bar-x",
        "status": "created",
        "task": "Foo-Bar-x"
      },
      "stderr": ""
    },
    {
      "argv": [
        "isolate",
        "create",
        "--task",
        "t1",
        "--repo",
        "<ROOT>/tmp"
      ],
      "exit": 1,
      "stdout_shape": "json-line",
      "stdout": {
        "reason": "not a git repository",
        "status": "error"
      },
      "stderr": ""
    },
    {
      "argv": [
        "isolate",
        "diff",
        "--task",
        "t1",
        "--repo",
        "<ROOT>/tmp"
      ],
      "exit": 1,
      "stdout_shape": "json-line",
      "stdout": {
        "reason": "not a git repository",
        "status": "error"
      },
      "stderr": ""
    },
    {
      "argv": [
        "isolate",
        "remove",
        "--task",
        "t1",
        "--repo",
        "<ROOT>/tmp"
      ],
      "exit": 1,
      "stdout_shape": "json-line",
      "stdout": {
        "reason": "not a git repository",
        "status": "error"
      },
      "stderr": ""
    },
    {
      "argv": [
        "isolate",
        "list",
        "--repo",
        "<ROOT>/tmp"
      ],
      "exit": 0,
      "stdout_shape": "json-line",
      "stdout": {
        "worktrees": []
      },
      "stderr": ""
    },
    {
      "argv": [
        "isolate",
        "remove",
        "--task",
        "nope"
      ],
      "exit": 0,
      "stdout_shape": "json-line",
      "stdout": {
        "status": "absent",
        "task": "nope"
      },
      "stderr": ""
    },
    {
      "argv": [
        "isolate",
        "diff",
        "--task",
        "nope"
      ],
      "exit": 0,
      "stdout_shape": "json-line",
      "stdout": {
        "files": [],
        "patch": "",
        "status": "absent",
        "task": "nope"
      },
      "stderr": ""
    },
    {
      "argv": [
        "isolate",
        "list",
        "--session",
        "bad session"
      ],
      "exit": 0,
      "stdout_shape": "json-line",
      "stdout": {
        "worktrees": []
      },
      "stderr": ""
    }
  ]
}
