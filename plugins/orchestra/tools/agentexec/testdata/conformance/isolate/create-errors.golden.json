{
  "scenario": "isolate/create-errors",
  "steps": [
    {
      "argv": [
        "isolate",
        "create"
      ],
      "exit": 2,
      "stdout_shape": "empty",
      "stdout": null
    },
    {
      "argv": [
        "isolate",
        "create",
        "--task",
        "t1",
        "--backend",
        "svn"
      ],
      "exit": 2,
      "stdout_shape": "empty",
      "stdout": null
    },
    {
      "argv": [
        "isolate",
        "create",
        "--task",
        "///"
      ],
      "exit": 2,
      "stdout_shape": "empty",
      "stdout": null
    },
    {
      "argv": [
        "isolate",
        "create",
        "--task",
        ".."
      ],
      "exit": 2,
      "stdout_shape": "empty",
      "stdout": null
    },
    {
      "argv": [
        "isolate",
        "create",
        "--task",
        "../Foo Bar//x"
      ],
      "exit": 0,
      "stdout_shape": "json",
      "stdout": {
        "backend": "git",
        "baseline": "<SHA#1>",
        "branch": "orchestra/00000000/Foo-Bar-x",
        "carried": [],
        "carried_files": [],
        "carry_method": "none",
        "path": "<WORK>-orchestra/00000000-Foo-Bar-x",
        "status": "created",
        "task": "Foo-Bar-x"
      }
    },
    {
      "argv": [
        "isolate",
        "create",
        "--task",
        "t1",
        "--repo",
        "<ROOT>/tmp"
      ],
      "exit": 1,
      "stdout_shape": "json",
      "stdout": {
        "reason": "not a git repository",
        "status": "error"
      }
    },
    {
      "argv": [
        "isolate",
        "diff",
        "--task",
        "t1",
        "--repo",
        "<ROOT>/tmp"
      ],
      "exit": 1,
      "stdout_shape": "json",
      "stdout": {
        "reason": "not a git repository",
        "status": "error"
      }
    },
    {
      "argv": [
        "isolate",
        "remove",
        "--task",
        "t1",
        "--repo",
        "<ROOT>/tmp"
      ],
      "exit": 1,
      "stdout_shape": "json",
      "stdout": {
        "reason": "not a git repository",
        "status": "error"
      }
    },
    {
      "argv": [
        "isolate",
        "list",
        "--repo",
        "<ROOT>/tmp"
      ],
      "exit": 0,
      "stdout_shape": "json",
      "stdout": {
        "worktrees": []
      }
    },
    {
      "argv": [
        "isolate",
        "remove",
        "--task",
        "nope"
      ],
      "exit": 0,
      "stdout_shape": "json",
      "stdout": {
        "status": "absent",
        "task": "nope"
      }
    },
    {
      "argv": [
        "isolate",
        "diff",
        "--task",
        "nope"
      ],
      "exit": 0,
      "stdout_shape": "json",
      "stdout": {
        "files": [],
        "patch": "",
        "status": "absent",
        "task": "nope"
      }
    }
  ]
}
