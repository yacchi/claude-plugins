{
  "scenario": "isolate/sweep-usage",
  "steps": [
    {
      "argv": [
        "isolate",
        "sweep",
        "--older-than",
        "abc"
      ],
      "exit": 2,
      "stdout_shape": "empty",
      "stdout": null,
      "stderr": "agent-exec: isolate sweep: --older-than takes a number of days\n"
    },
    {
      "argv": [
        "isolate",
        "sweep",
        "--older-than",
        "-1"
      ],
      "exit": 2,
      "stdout_shape": "empty",
      "stdout": null,
      "stderr": "agent-exec: isolate sweep: --older-than takes a number of days\n"
    },
    {
      "argv": [
        "isolate",
        "sweep",
        "--live-window",
        "soon"
      ],
      "exit": 2,
      "stdout_shape": "empty",
      "stdout": null,
      "stderr": "agent-exec: isolate sweep: --live-window takes a number of minutes\n"
    },
    {
      "argv": [
        "isolate",
        "sweep",
        "--live-window",
        "-5"
      ],
      "exit": 2,
      "stdout_shape": "empty",
      "stdout": null,
      "stderr": "agent-exec: isolate sweep: --live-window takes a number of minutes\n"
    },
    {
      "argv": [
        "isolate",
        "sweep",
        "--json",
        "--text"
      ],
      "exit": 2,
      "stdout_shape": "empty",
      "stdout": null,
      "stderr": "agent-exec: isolate sweep: --json and --text are mutually exclusive\n"
    },
    {
      "argv": [
        "isolate",
        "sweep",
        "--dry-run",
        "--dry-run"
      ],
      "exit": 2,
      "stdout_shape": "empty",
      "stdout": null,
      "stderr": "agent-exec: isolate sweep: duplicate option: --dry-run\n"
    },
    {
      "argv": [
        "isolate",
        "sweep",
        "--repo"
      ],
      "exit": 2,
      "stdout_shape": "empty",
      "stdout": null,
      "stderr": "agent-exec: isolate sweep: missing value for --repo\n"
    },
    {
      "argv": [
        "isolate",
        "sweep",
        "--bogus"
      ],
      "exit": 2,
      "stdout_shape": "empty",
      "stdout": null,
      "stderr": "agent-exec: isolate sweep: unknown option: --bogus\n"
    },
    {
      "argv": [
        "isolate",
        "sweep",
        "stray"
      ],
      "exit": 2,
      "stdout_shape": "empty",
      "stdout": null,
      "stderr": "agent-exec: isolate sweep: unknown option: stray\n"
    },
    {
      "argv": [
        "isolate",
        "sweep",
        "--repo",
        "<ROOT>/tmp"
      ],
      "exit": 1,
      "stdout_shape": "json-line",
      "stdout": {
        "reason": "not a git repository",
        "status": "error"
      },
      "stderr": ""
    },
    {
      "argv": [
        "isolate",
        "sweep",
        "--repo",
        "<ROOT>/tmp",
        "--text"
      ],
      "exit": 1,
      "stdout_shape": "text",
      "stdout": "sweep error  not a git repository\n",
      "stderr": ""
    },
    {
      "argv": [
        "isolate",
        "sweep",
        "--dry-run"
      ],
      "exit": 0,
      "stdout_shape": "json-line",
      "stdout": {
        "branches": [],
        "dry_run": true,
        "pruned": false,
        "repo": "<WORK>",
        "status": "ok",
        "summary": {
          "absent": 0,
          "branches_deleted": 0,
          "branches_orphan": 0,
          "branches_would_delete": 0,
          "dirty": 0,
          "errors": 0,
          "external": 0,
          "removed": 0,
          "skipped": 0,
          "would_remove": 0
        },
        "worktrees": []
      },
      "stderr": ""
    },
    {
      "argv": [
        "isolate",
        "sweep",
        "--text"
      ],
      "exit": 0,
      "stdout_shape": "text",
      "stdout": "sweep <WORK>\nsummary: removed 0, would-remove 0, dirty 0, skipped 0, external 0, errors 0, branches 0 orphan / 0 deleted\n",
      "stderr": ""
    }
  ]
}
