{
  "scenario": "isolate/sweep-usage",
  "steps": [
    {
      "argv": [
        "isolate",
        "sweep",
        "--older-than",
        "abc"
      ],
      "exit": 2,
      "stdout_shape": "empty",
      "stdout": null
    },
    {
      "argv": [
        "isolate",
        "sweep",
        "--bogus"
      ],
      "exit": 2,
      "stdout_shape": "empty",
      "stdout": null
    },
    {
      "argv": [
        "isolate",
        "sweep",
        "--repo",
        "<ROOT>/tmp"
      ],
      "exit": 1,
      "stdout_shape": "json",
      "stdout": {
        "reason": "not a git repository",
        "status": "error"
      }
    },
    {
      "argv": [
        "isolate",
        "sweep",
        "--repo",
        "<ROOT>/tmp",
        "--text"
      ],
      "exit": 1,
      "stdout_shape": "text",
      "stdout": "sweep error  not a git repository\n"
    },
    {
      "argv": [
        "isolate",
        "sweep",
        "--dry-run"
      ],
      "exit": 0,
      "stdout_shape": "json",
      "stdout": {
        "branches": [],
        "dry_run": true,
        "pruned": false,
        "repo": "<WORK>",
        "status": "ok",
        "summary": {
          "absent": 0,
          "branches_deleted": 0,
          "branches_orphan": 0,
          "branches_would_delete": 0,
          "dirty": 0,
          "errors": 0,
          "external": 0,
          "has_children": 0,
          "removed": 0,
          "skipped": 0,
          "trash_removed": 0,
          "would_remove": 0
        },
        "worktrees": []
      }
    },
    {
      "argv": [
        "isolate",
        "sweep",
        "--text"
      ],
      "exit": 0,
      "stdout_shape": "text",
      "stdout": "sweep <WORK>\nsummary: removed 0, would-remove 0, dirty 0, has-children 0, skipped 0, external 0, errors 0, branches 0 orphan / 0 deleted\n"
    }
  ]
}
