{
  "scenario": "pi-login/device-flow",
  "steps": [
    {
      "argv": [
        "pi",
        "login",
        "--json"
      ],
      "exit": 0,
      "stdout_shape": "json",
      "stdout": {
        "code": "ABCD-1234",
        "method": "device",
        "paste_prompt": false,
        "provider": "openai-codex",
        "session": "<SESSION>",
        "status": "waiting",
        "url": "https://auth.openai.com/codex/device"
      }
    },
    {
      "argv": [
        "pi",
        "login",
        "--paste",
        "http://localhost:1455/auth/callback?code=x",
        "--timeout",
        "30"
      ],
      "exit": 0,
      "stdout_shape": "json",
      "stdout": {
        "provider": "openai-codex",
        "status": "ready"
      }
    },
    {
      "argv": [
        "pi",
        "login",
        "--wait",
        "--timeout",
        "1"
      ],
      "exit": 1,
      "stdout_shape": "json",
      "stdout": {
        "reason": "no login in progress (run `agent-exec pi login` first)",
        "screen_tail": "",
        "status": "failed"
      }
    }
  ]
}
