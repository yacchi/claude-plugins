{
  "scenario": "config/layers",
  "steps": [
    {
      "argv": [
        "config",
        "--json"
      ],
      "exit": 0,
      "stdout_shape": "json",
      "stdout": {
        "checks": {
          "ensure": [],
          "flaky_threshold": 3,
          "items": [
            {
              "name": "lint",
              "run": "echo {files}"
            }
          ],
          "max_parallel": 0,
          "retry_failed_alone": true
        },
        "cooldown": {
          "enabled": true,
          "path": "~/.claude/orchestra/executor-state.json",
          "seconds": {
            "auth": 0,
            "credits": 3600,
            "nonzero-exit": 0,
            "quota": 3600,
            "rate-limit": 900,
            "sandbox": 0
          }
        },
        "custom_user_key": {
          "a": 1
        },
        "enforcement": {
          "fanout": {
            "checker_calls": 8,
            "children": 6,
            "concurrent": 2,
            "scout_calls": 15,
            "writer_calls": 40
          },
          "light_class": "off",
          "opus_generalist": "nudge",
          "resume_max_tokens": 200000,
          "resume_max_tokens_by_model": {
            "haiku": 100000
          },
          "session_cleanup": "on",
          "turn_edits": 8,
          "usage_advise": 75,
          "usage_guard": 95,
          "worker_vcs": "block"
        },
        "external_executors": {
          "pi": {
            "agent_dir": "managed",
            "available": false,
            "class_policy": {
              "deep": {
                "effort": "high",
                "model": "openai-codex/gpt-6.1-sol"
              },
              "independent-review": {
                "effort": "medium",
                "model": "openai-codex/gpt-6.1-sol"
              },
              "light": {
                "effort": "medium",
                "model": "openai-codex/gpt-5.6-luna"
              },
              "standard": {
                "effort": "high",
                "model": "openai-codex/gpt-5.6-luna"
              }
            },
            "classes": [
              "light",
              "standard",
              "deep",
              "independent-review"
            ],
            "context_files": true,
            "dispatch": "cli",
            "enabled": true
          }
        },
        "herdr": {
          "add_dirs": [],
          "args": "--model {model} --permission-mode {permission_mode}",
          "auto_trust": true,
          "enabled": "auto",
          "keep_sessions": true,
          "models": {
            "deep": "opus",
            "light": "sonnet",
            "standard": "opus"
          },
          "permission_mode": "auto",
          "startup_timeout": 90,
          "task_timeout": 3600,
          "user_config": "isolate",
          "warm": {
            "enabled": true,
            "min_packages": 2,
            "ttl_seconds": 3000
          }
        },
        "interactive_host": "auto",
        "isolation": {
          "carry_extra": [],
          "carry_files": [
            ".claude/settings.local.json",
            ".claude/orchestra.local.yaml",
            "CLAUDE.local.md"
          ],
          "exclude_paths": [
            ".pnpm-store/",
            "node_modules/",
            ".venv/",
            "__pycache__/",
            ".turbo/",
            ".next/",
            ".gradle/",
            ".terraform/"
          ],
          "keep_paths": [],
          "land": "auto",
          "max_added_files": 500,
          "pnpm_global_virtual_store": "auto"
        },
        "ledger": {
          "dir": "~/.claude/orchestra/runs",
          "enabled": true,
          "retention_days": 7
        },
        "orca": {
          "add_dirs": [],
          "auto_trust": false,
          "command": "claude --model {model} --permission-mode {permission_mode}",
          "enabled": "auto",
          "keep_sessions": true,
          "models": {
            "deep": "opus",
            "light": "sonnet",
            "standard": "opus"
          },
          "permission_mode": "auto",
          "setup": "skip",
          "startup_timeout": 90,
          "task_timeout": 3600,
          "user_config": "isolate"
        },
        "planning": {
          "redo": {
            "effort": "max",
            "model": "opus"
          },
          "redo_when": {
            "deep_packages": 3,
            "interface_users": 5,
            "structural_findings": 1
          },
          "review": true,
          "spec_writers": {
            "deep": {
              "effort": "max",
              "model": "opus"
            },
            "light": {
              "effort": "medium",
              "model": "sonnet"
            },
            "standard": {
              "effort": "high",
              "model": "opus"
            }
          },
          "writers_concurrent": 8
        },
        "priority": {
          "deep": {
            "default": [
              "claude",
              "pi"
            ]
          },
          "independent-review": {
            "default": [
              "pi"
            ]
          },
          "light": {
            "default": [
              "claude",
              "pi"
            ],
            "investigation": [
              "claude",
              "pi"
            ]
          },
          "review": {
            "default": [
              "claude"
            ]
          },
          "standard": {
            "default": [
              "claude"
            ],
            "investigation": [
              "pi"
            ]
          }
        },
        "sandbox": {
          "allow_write": [],
          "deny_read": [],
          "learned": [],
          "mode": "off",
          "network": {
            "allowed_domains": [
              "api.anthropic.com"
            ],
            "denied_domains": [],
            "ecosystem": true,
            "mode": "allowlist",
            "quiet_domains": [
              "mcp-proxy.anthropic.com",
              "downloads.claude.ai",
              "statsig.anthropic.com",
              "datadoghq.com",
              "*.datadoghq.com",
              "sentry.io",
              "*.sentry.io",
              "herdr.dev"
            ]
          }
        },
        "telemetry": {
          "dir": null,
          "enabled": false
        },
        "throttle": {
          "heavy_extra": [],
          "heavy_slots": "auto",
          "test_slots": "auto"
        },
        "tiers": {
          "deep": "sonnet",
          "light": "sonnet",
          "planner": {
            "effort": "xhigh",
            "model": "opus"
          },
          "review": "haiku",
          "standard": {
            "effort": "high",
            "model": "haiku"
          }
        },
        "tools": {
          "herdr": {
            "bin": "herdr",
            "source": "auto",
            "spec": "aqua:herdrdev/herdr",
            "version": "0.8.2"
          },
          "installer": "auto",
          "pi": {
            "bin": "pi",
            "source": "auto",
            "spec": "npm:@earendil-works/pi-coding-agent",
            "version": "1.2.0"
          },
          "srt": {
            "bin": "srt",
            "source": "auto",
            "spec": "npm:@anthropic-ai/sandbox-runtime",
            "version": "0.0.79"
          }
        },
        "usage_routing": {
          "cache_seconds": 120,
          "enabled": true,
          "thresholds": {
            "five_hour": 80,
            "seven_day": 90
          }
        },
        "warnings": [],
        "watchdog": {
          "enabled": true,
          "idle_seconds": 600,
          "repeat_limit": 9,
          "tool_idle_seconds": 900,
          "wall_seconds": {
            "deep": 99,
            "independent-review": 2400,
            "light": 1200,
            "standard": 2400
          }
        },
        "wave": {
          "budget_usd": 0,
          "max_in_flight": "auto",
          "memory_guard": true,
          "usage_every": 10
        }
      }
    }
  ]
}
