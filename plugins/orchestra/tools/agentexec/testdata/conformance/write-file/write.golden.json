{
  "scenario": "write-file/write",
  "steps": [
    {
      "argv": [
        "write-file",
        "--path",
        "out.txt"
      ],
      "exit": 0,
      "stdout_shape": "json",
      "stdout": {
        "chars": 11,
        "path": "<WORK>/out.txt",
        "status": "ok"
      },
      "files": {
        "out.txt": {
          "content": "hello world",
          "shape": "text"
        }
      }
    },
    {
      "argv": [
        "write-file",
        "--path",
        "deep/nested/dir/out.md",
        "--expect-chars",
        "4"
      ],
      "exit": 0,
      "stdout_shape": "json",
      "stdout": {
        "chars": 4,
        "path": "<WORK>/deep/nested/dir/out.md",
        "status": "ok"
      },
      "files": {
        "deep/nested/dir/out.md": {
          "content": "日本語。\n",
          "shape": "text"
        }
      }
    },
    {
      "argv": [
        "write-file",
        "--path",
        "crlf.txt",
        "--expect-chars",
        "13"
      ],
      "exit": 0,
      "stdout_shape": "json",
      "stdout": {
        "chars": 13,
        "path": "<WORK>/crlf.txt",
        "status": "ok"
      },
      "files": {
        "crlf.txt": {
          "content": "line1\r\nline2\r\n",
          "shape": "text"
        }
      }
    },
    {
      "argv": [
        "write-file",
        "--path",
        "existing.txt",
        "--expect-chars",
        "3"
      ],
      "exit": 1,
      "stdout_shape": "json",
      "stdout": {
        "chars": 12,
        "expected": 3,
        "path": "<WORK>/existing.txt",
        "status": "mismatch"
      },
      "files": {
        "existing.txt": {
          "content": "old content\n",
          "shape": "text"
        }
      }
    },
    {
      "argv": [
        "write-file",
        "--path",
        "existing.txt",
        "--expect-chars",
        "-1"
      ],
      "exit": 1,
      "stdout_shape": "json",
      "stdout": {
        "chars": 0,
        "expected": -1,
        "path": "<WORK>/existing.txt",
        "status": "mismatch"
      },
      "files": {
        "existing.txt": {
          "content": "old content\n",
          "shape": "text"
        }
      }
    },
    {
      "argv": [
        "write-file",
        "--path",
        "empty.txt",
        "--expect-chars",
        "0"
      ],
      "exit": 0,
      "stdout_shape": "json",
      "stdout": {
        "chars": 0,
        "path": "<WORK>/empty.txt",
        "status": "ok"
      },
      "files": {
        "empty.txt": {
          "content": null,
          "shape": "empty"
        }
      }
    },
    {
      "argv": [
        "write-file",
        "--path",
        "emoji.txt",
        "--expect-chars",
        "3"
      ],
      "exit": 0,
      "stdout_shape": "json",
      "stdout": {
        "chars": 3,
        "path": "<WORK>/emoji.txt",
        "status": "ok"
      },
      "files": {
        "emoji.txt": {
          "content": "é😀",
          "shape": "text"
        }
      }
    },
    {
      "argv": [
        "write-file",
        "--path",
        "sub/../abs.txt"
      ],
      "exit": 0,
      "stdout_shape": "json",
      "stdout": {
        "chars": 1,
        "path": "<WORK>/abs.txt",
        "status": "ok"
      },
      "files": {
        "abs.txt": {
          "content": "x",
          "shape": "text"
        }
      }
    },
    {
      "argv": [
        "write-file"
      ],
      "exit": 2,
      "stdout_shape": "empty",
      "stdout": null
    },
    {
      "argv": [
        "write-file",
        "--path",
        "x.txt",
        "--expect-chars",
        "ten"
      ],
      "exit": 2,
      "stdout_shape": "empty",
      "stdout": null
    }
  ]
}
