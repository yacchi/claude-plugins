{
  "scenario": "wave/lint-usage",
  "steps": [
    {
      "argv": [
        "wave",
        "lint"
      ],
      "exit": 2,
      "stdout_shape": "empty",
      "stdout": null
    },
    {
      "argv": [
        "wave",
        "lint",
        "--bogus"
      ],
      "exit": 2,
      "stdout_shape": "empty",
      "stdout": null
    },
    {
      "argv": [
        "wave",
        "status"
      ],
      "exit": 2,
      "stdout_shape": "empty",
      "stdout": null
    },
    {
      "argv": [
        "wave",
        "status",
        "--state",
        "s.json"
      ],
      "exit": 3,
      "stdout_shape": "empty",
      "stdout": null
    },
    {
      "argv": [
        "wave",
        "status",
        "--state",
        "s.json",
        "--json"
      ],
      "exit": 3,
      "stdout_shape": "empty",
      "stdout": null
    },
    {
      "argv": [
        "wave",
        "stop"
      ],
      "exit": 2,
      "stdout_shape": "empty",
      "stdout": null
    }
  ]
}
