{
  "scenario": "dispatch/usage-errors",
  "steps": [
    {
      "argv": [
        "dispatch",
        "prepare",
        "--class",
        "standard",
        "--prompt-file",
        "p.md",
        "--workdir",
        "."
      ],
      "exit": 0,
      "stdout_shape": "json",
      "stdout": {
        "config_layers": [
          "<HOME>/.claude/orchestra.yaml"
        ],
        "token": "<TOKEN#1>"
      }
    },
    {
      "argv": [
        "dispatch",
        "--token",
        "<@TOK>",
        "--workdir",
        "."
      ],
      "exit": 2,
      "stdout_shape": "empty",
      "stdout": null
    },
    {
      "argv": [
        "dispatch",
        "--token",
        "<@TOK>",
        "--no-cooldown",
        "--resume",
        "abc",
        "--task",
        "t",
        "--isolate",
        "never",
        "--run-id",
        "r",
        "--archetype",
        "a",
        "--workdir",
        ".",
        "--prompt-file",
        "p.md"
      ],
      "exit": 2,
      "stdout_shape": "empty",
      "stdout": null
    },
    {
      "argv": [
        "dispatch",
        "--detach",
        "--class",
        "light",
        "--prompt-file",
        "p.md",
        "--workdir",
        "."
      ],
      "exit": 2,
      "stdout_shape": "empty",
      "stdout": null
    },
    {
      "argv": [
        "dispatch",
        "--summary",
        "--class",
        "light",
        "--prompt-file",
        "p.md",
        "--workdir",
        "."
      ],
      "exit": 2,
      "stdout_shape": "empty",
      "stdout": null
    },
    {
      "argv": [
        "dispatch",
        "--prompt-file",
        "p.md",
        "--workdir",
        "."
      ],
      "exit": 2,
      "stdout_shape": "empty",
      "stdout": null
    },
    {
      "argv": [
        "dispatch",
        "--class",
        "light",
        "--prompt-file",
        "missing.md",
        "--workdir",
        "."
      ],
      "exit": 2,
      "stdout_shape": "empty",
      "stdout": null
    },
    {
      "argv": [
        "dispatch",
        "--class",
        "light",
        "--prompt-file",
        "p.md",
        "--workdir",
        ".",
        "--run-id",
        "../x"
      ],
      "exit": 2,
      "stdout_shape": "empty",
      "stdout": null
    },
    {
      "argv": [
        "dispatch",
        "--token",
        "dsp-XYZ"
      ],
      "exit": 2,
      "stdout_shape": "empty",
      "stdout": null
    },
    {
      "argv": [
        "dispatch",
        "--token",
        "dsp-000000000000"
      ],
      "exit": 2,
      "stdout_shape": "empty",
      "stdout": null
    },
    {
      "argv": [
        "dispatch",
        "--token",
        "../../etc/passwd"
      ],
      "exit": 2,
      "stdout_shape": "empty",
      "stdout": null
    },
    {
      "argv": [
        "dispatch",
        "wait"
      ],
      "exit": 2,
      "stdout_shape": "empty",
      "stdout": null
    },
    {
      "argv": [
        "dispatch",
        "wait",
        "--token",
        "not-a-token"
      ],
      "exit": 2,
      "stdout_shape": "empty",
      "stdout": null
    },
    {
      "argv": [
        "dispatch",
        "wait",
        "--token",
        "dsp-000000000000",
        "--max-wait",
        "0"
      ],
      "exit": 0,
      "stdout_shape": "json",
      "stdout": {
        "status": "unknown-token",
        "token": "<TOKEN#2>"
      }
    },
    {
      "argv": [
        "dispatch",
        "wait",
        "--token",
        "<@TOK>",
        "--max-wait",
        "0",
        "--summary"
      ],
      "exit": 0,
      "stdout_shape": "json",
      "stdout": {
        "status": "unknown-token",
        "token": "<TOKEN#1>"
      }
    }
  ]
}
