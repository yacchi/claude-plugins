{
  "scenario": "tools/install-offline",
  "steps": [
    {
      "argv": [
        "tools",
        "install",
        "pi"
      ],
      "exit": 0,
      "stdout_shape": "text",
      "stdout": "pi  already  1.2.0  <HOME>/managed/pi\n"
    },
    {
      "argv": [
        "tools",
        "install",
        "pi",
        "--json"
      ],
      "exit": 0,
      "stdout_shape": "json",
      "stdout": [
        {
          "error": null,
          "installer": "npm",
          "name": "pi",
          "path": "<HOME>/managed/pi",
          "status": "already",
          "version": "1.2.0"
        }
      ]
    },
    {
      "argv": [
        "tools",
        "install",
        "pi",
        "--installer",
        "bogus"
      ],
      "exit": 2,
      "stdout_shape": "empty",
      "stdout": null
    },
    {
      "argv": [
        "tools",
        "install",
        "pi",
        "--force",
        "--installer",
        "npm",
        "--json"
      ],
      "exit": 1,
      "stdout_shape": "json",
      "stdout": [
        {
          "error": "exec: \"npm\": executable file not found in $PATH",
          "installer": "npm",
          "name": "pi",
          "path": null,
          "status": "failed",
          "version": "1.2.0"
        }
      ]
    },
    {
      "argv": [
        "tools",
        "install",
        "pi",
        "--force",
        "--installer",
        "mise"
      ],
      "exit": 1,
      "stdout_shape": "text",
      "stdout": "pi  failed  1.2.0  -  exec: \"mise\": executable file not found in $PATH\n"
    },
    {
      "argv": [
        "tools",
        "install",
        "pi",
        "--force"
      ],
      "exit": 1,
      "stdout_shape": "text",
      "stdout": "pi  failed  1.2.0  -  exec: \"npm\": executable file not found in $PATH\n"
    },
    {
      "argv": [
        "tools",
        "install",
        "nosuch"
      ],
      "exit": 2,
      "stdout_shape": "empty",
      "stdout": null
    },
    {
      "argv": [
        "tools",
        "install"
      ],
      "exit": 0,
      "stdout_shape": "empty",
      "stdout": null
    },
    {
      "argv": [
        "tools",
        "install",
        "pi",
        "--json"
      ],
      "exit": 0,
      "stdout_shape": "json",
      "stdout": [
        {
          "error": null,
          "installer": null,
          "name": "pi",
          "path": null,
          "status": "skipped",
          "version": null
        }
      ]
    }
  ]
}
