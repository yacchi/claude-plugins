{
  "scenario": "integrate/usage",
  "steps": [
    {
      "argv": [
        "isolate",
        "integrate"
      ],
      "exit": 2,
      "stdout_shape": "empty",
      "stdout": null,
      "stderr": "agent-exec: isolate integrate: missing required option: --tasks\n"
    },
    {
      "argv": [
        "isolate",
        "integrate",
        "--tasks",
        " , ,"
      ],
      "exit": 2,
      "stdout_shape": "empty",
      "stdout": null,
      "stderr": "agent-exec: isolate integrate: --tasks is empty\n"
    },
    {
      "argv": [
        "isolate",
        "integrate",
        "--tasks",
        "a",
        "--tasks",
        "b"
      ],
      "exit": 2,
      "stdout_shape": "empty",
      "stdout": null,
      "stderr": "agent-exec: isolate integrate: duplicate option: --tasks\n"
    },
    {
      "argv": [
        "isolate",
        "integrate",
        "--tasks",
        "a",
        "--bisect",
        "--bisect",
        "--verify",
        "true"
      ],
      "exit": 2,
      "stdout_shape": "empty",
      "stdout": null,
      "stderr": "agent-exec: isolate integrate: duplicate option: --bisect\n"
    },
    {
      "argv": [
        "isolate",
        "integrate",
        "--tasks",
        "a",
        "--progress-jsonl",
        "x",
        "--progress-jsonl",
        "y"
      ],
      "exit": 2,
      "stdout_shape": "empty",
      "stdout": null,
      "stderr": "agent-exec: isolate integrate: duplicate option: --progress-jsonl\n"
    },
    {
      "argv": [
        "isolate",
        "integrate",
        "--tasks",
        "a",
        "--bogus"
      ],
      "exit": 2,
      "stdout_shape": "empty",
      "stdout": null,
      "stderr": "agent-exec: isolate integrate: unknown option: --bogus\n"
    },
    {
      "argv": [
        "isolate",
        "integrate",
        "--tasks",
        "a",
        "extra"
      ],
      "exit": 2,
      "stdout_shape": "empty",
      "stdout": null,
      "stderr": "agent-exec: isolate integrate: unknown option: extra\n"
    },
    {
      "argv": [
        "isolate",
        "integrate",
        "--tasks"
      ],
      "exit": 2,
      "stdout_shape": "empty",
      "stdout": null,
      "stderr": "agent-exec: isolate integrate: missing value for --tasks\n"
    },
    {
      "argv": [
        "isolate",
        "integrate",
        "--tasks",
        "a",
        "--progress-jsonl"
      ],
      "exit": 2,
      "stdout_shape": "empty",
      "stdout": null,
      "stderr": "agent-exec: isolate integrate: missing value for --progress-jsonl\n"
    },
    {
      "argv": [
        "isolate",
        "integrate",
        "--tasks",
        "a",
        "--json",
        "--text"
      ],
      "exit": 2,
      "stdout_shape": "empty",
      "stdout": null,
      "stderr": "agent-exec: isolate integrate: --json and --text are mutually exclusive\n"
    },
    {
      "argv": [
        "isolate",
        "integrate",
        "--tasks",
        "a",
        "--on-conflict",
        "merge"
      ],
      "exit": 2,
      "stdout_shape": "empty",
      "stdout": null,
      "stderr": "agent-exec: isolate integrate: invalid --on-conflict value: merge\n"
    },
    {
      "argv": [
        "isolate",
        "integrate",
        "--tasks",
        "a",
        "--verify-timeout",
        "0"
      ],
      "exit": 2,
      "stdout_shape": "empty",
      "stdout": null,
      "stderr": "agent-exec: isolate integrate: invalid --verify-timeout value: 0\n"
    },
    {
      "argv": [
        "isolate",
        "integrate",
        "--tasks",
        "a",
        "--verify-timeout",
        "1.5"
      ],
      "exit": 2,
      "stdout_shape": "empty",
      "stdout": null,
      "stderr": "agent-exec: isolate integrate: invalid --verify-timeout value: 1.5\n"
    },
    {
      "argv": [
        "isolate",
        "integrate",
        "--tasks",
        "a",
        "--bisect-max",
        "-1"
      ],
      "exit": 2,
      "stdout_shape": "empty",
      "stdout": null,
      "stderr": "agent-exec: isolate integrate: invalid --bisect-max value: -1\n"
    },
    {
      "argv": [
        "isolate",
        "integrate",
        "--tasks",
        "a",
        "--bisect-max",
        "two"
      ],
      "exit": 2,
      "stdout_shape": "empty",
      "stdout": null,
      "stderr": "agent-exec: isolate integrate: invalid --bisect-max value: two\n"
    },
    {
      "argv": [
        "isolate",
        "integrate",
        "--tasks",
        "a",
        "--bisect"
      ],
      "exit": 2,
      "stdout_shape": "empty",
      "stdout": null,
      "stderr": "agent-exec: isolate integrate: --bisect requires --verify\n"
    },
    {
      "argv": [
        "isolate",
        "integrate",
        "--tasks",
        "a",
        "--lock",
        "never"
      ],
      "exit": 2,
      "stdout_shape": "empty",
      "stdout": null,
      "stderr": "agent-exec: isolate integrate: invalid --lock value: never\n"
    },
    {
      "argv": [
        "isolate",
        "integrate",
        "--tasks",
        "a",
        "--lock-timeout",
        "-1"
      ],
      "exit": 2,
      "stdout_shape": "empty",
      "stdout": null,
      "stderr": "agent-exec: isolate integrate: invalid --lock-timeout value: -1.0\n"
    },
    {
      "argv": [
        "isolate",
        "integrate",
        "--tasks",
        "a",
        "--lock-timeout",
        "inf"
      ],
      "exit": 2,
      "stdout_shape": "empty",
      "stdout": null,
      "stderr": "agent-exec: isolate integrate: invalid --lock-timeout value: inf\n"
    },
    {
      "argv": [
        "isolate",
        "integrate",
        "--tasks",
        "a",
        "--lock-timeout",
        "nan"
      ],
      "exit": 2,
      "stdout_shape": "empty",
      "stdout": null,
      "stderr": "agent-exec: isolate integrate: invalid --lock-timeout value: nan\n"
    },
    {
      "argv": [
        "isolate",
        "integrate",
        "--tasks",
        "a,//"
      ],
      "exit": 2,
      "stdout_shape": "empty",
      "stdout": null,
      "stderr": "agent-exec: isolate integrate: task id '//' has no usable characters\n"
    },
    {
      "argv": [
        "isolate",
        "integrate",
        "--tasks",
        "a",
        "--into",
        "../.."
      ],
      "exit": 2,
      "stdout_shape": "empty",
      "stdout": null,
      "stderr": "agent-exec: isolate integrate: task id '../..' has no usable characters\n"
    },
    {
      "argv": [
        "isolate",
        "list"
      ],
      "exit": 0,
      "stdout_shape": "json-line",
      "stdout": {
        "worktrees": []
      },
      "stderr": ""
    }
  ]
}
