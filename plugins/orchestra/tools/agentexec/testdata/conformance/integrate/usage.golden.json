{
  "scenario": "integrate/usage",
  "steps": [
    {
      "argv": [
        "isolate",
        "integrate"
      ],
      "exit": 2,
      "stdout_shape": "empty",
      "stdout": null
    },
    {
      "argv": [
        "isolate",
        "integrate",
        "--tasks",
        " , ,"
      ],
      "exit": 2,
      "stdout_shape": "empty",
      "stdout": null
    },
    {
      "argv": [
        "isolate",
        "integrate",
        "--tasks",
        "a",
        "--tasks",
        "b"
      ],
      "exit": 2,
      "stdout_shape": "empty",
      "stdout": null
    },
    {
      "argv": [
        "isolate",
        "integrate",
        "--tasks",
        "a",
        "--bogus"
      ],
      "exit": 2,
      "stdout_shape": "empty",
      "stdout": null
    },
    {
      "argv": [
        "isolate",
        "integrate",
        "--tasks",
        "a",
        "--on-conflict",
        "merge"
      ],
      "exit": 2,
      "stdout_shape": "empty",
      "stdout": null
    },
    {
      "argv": [
        "isolate",
        "integrate",
        "--tasks",
        "a",
        "--bisect"
      ],
      "exit": 2,
      "stdout_shape": "empty",
      "stdout": null
    },
    {
      "argv": [
        "isolate",
        "integrate",
        "--tasks",
        "a,//"
      ],
      "exit": 2,
      "stdout_shape": "empty",
      "stdout": null
    },
    {
      "argv": [
        "isolate",
        "integrate",
        "--tasks",
        "a",
        "--into",
        "../.."
      ],
      "exit": 2,
      "stdout_shape": "empty",
      "stdout": null
    },
    {
      "argv": [
        "isolate",
        "list"
      ],
      "exit": 0,
      "stdout_shape": "json",
      "stdout": {
        "worktrees": []
      }
    }
  ]
}
